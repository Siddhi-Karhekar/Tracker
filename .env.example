# Copy to .env and fill in. Never commit .env.

# Where the SQLite database lives
TEAMPULSE_DB=data/teampulse.db

# ---------- GitHub ----------
# Fine-grained token with Issues, Pull requests, Contents (read; write only for seeding)
GITHUB_TOKEN=
GITHUB_REPO=Siddhi-Karhekar/teampulse-demo
# Optional, for seeding only: per-member tokens so PRs/reviews are authored by the right person.
# Key = handle from team.toml, upper-cased.
# GITHUB_TOKEN__SIDDHI=
# GITHUB_TOKEN__AARAV=
# GITHUB_TOKEN__PRIYA=
# GITHUB_TOKEN__ROHAN=

# ---------- Notion ----------
# Internal integration secret; share the task database (or its parent page) with the integration
NOTION_TOKEN=
NOTION_DATABASE_ID=
# Seeding only: the page under which the demo task database is created
NOTION_PARENT_PAGE_ID=

# ---------- Discord ----------
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Comma-separated channel names to read (empty = every text channel the bot can see)
DISCORD_CHANNELS=general,backend,frontend,ml-and-data,standup
# Seeding only: one webhook URL per channel, as  name=url,name=url
DISCORD_WEBHOOKS=
