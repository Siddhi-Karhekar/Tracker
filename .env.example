# Copy to .env and fill in. Never commit .env.

# Which database to use. data/demo.db = demo team (python -m teampulse.seed_demo); data/teampulse.db = your real team.
TEAMPULSE_DB=data/demo.db
POLL_MINUTES=5

# --- Language models (all free; tried in this order, next one used if one fails) ---
LLM_PROVIDERS=groq,gemini,ollama
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# For REAL team data, use only Ollama:  LLM_PROVIDERS=ollama
# Seconds between AI calls. Free tiers allow ~30 requests/minute: use 2 when running the evaluation.
TEAMPULSE_LLM_MIN_INTERVAL=0
# Check each cited statement against its source after every answer (one extra AI call). on | off
TEAMPULSE_VERIFY=on
# Members must approve their own contribution report before the team sees it. on | off
TEAMPULSE_CONTRIB_REVIEW=on

# --- Search model (runs locally, downloaded once, ~0.2 GB). "hash" = offline keyword-only fallback. ---
# Heavier alternative: pip install sentence-transformers, then TEAMPULSE_EMBEDDER=intfloat/multilingual-e5-small
TEAMPULSE_EMBEDDER=fastembed:sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Optional: minimum similarity to auto-link a chat message to a task (default 0.65; 0.84 for e5 models)
TEAMPULSE_LINK_THRESHOLD=

# --- Public demo (for a deployed copy): fictional demo team, reset daily, questions limited per visitor ---
TEAMPULSE_PUBLIC_DEMO=off
TEAMPULSE_DEMO_QUESTION_LIMIT=15

# --- Tracing (optional): set to phoenix, then run `phoenix serve` and open http://localhost:6006 ---
TEAMPULSE_TRACING=off
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# --- Discord ---
DISCORD_BOT_TOKEN=
# your team server's ID (right-click server > Copy Server ID)
DISCORD_GUILD_ID=
DISCORD_BACKFILL_DAYS=30

# --- GitHub ---
# fine-grained token, read-only (see README)
GITHUB_TOKEN=
# owner/repo, comma-separated
GITHUB_REPOS=
GITHUB_BACKFILL_DAYS=90

# --- Notion ---
# internal integration secret
NOTION_TOKEN=
# task database IDs, comma-separated
NOTION_DATABASE_IDS=
# standalone plan/goal pages, comma-separated
NOTION_PAGE_IDS=
NOTION_BACKFILL_DAYS=90
# Optional: property names in your task database (auto-detected by type if blank)
NOTION_PROP_STATUS=
NOTION_PROP_ASSIGNEE=
NOTION_PROP_DUE=

# --- Sign-in and security ---
# Accounts are on by default. "off" is only for local development on your own laptop.
TEAMPULSE_AUTH=on
# Lets the first team leader account be created from the sign-in page (e.g. on Streamlit Cloud).
# Use a long random value, and remove it once the leader account exists.
TEAMPULSE_SETUP_CODE=
# Sessions end after this many hours, or after this many idle minutes.
TEAMPULSE_SESSION_HOURS=12
TEAMPULSE_IDLE_MINUTES=60
# Questions each person can ask the AI per hour (protects your free LLM quota).
TEAMPULSE_ASK_PER_HOUR=60
# Members can approve or dispute only their own contribution report. Set to "off" for strictly read-only members.
TEAMPULSE_CONTRIB_REVIEW=on
# Longest AI reply, in tokens (caps cost and time per request).
TEAMPULSE_LLM_MAX_TOKENS=1500

# --- Retention and backups (see teampulse/maintenance.py) ---
# Activity log entries and cached AI responses are deleted after this many days.
TEAMPULSE_AUDIT_DAYS=180
TEAMPULSE_CACHE_DAYS=30
# Folder for daily backups made by the poll loop (empty = no automatic backups). Keep the newest N.
TEAMPULSE_BACKUP_DIR=
TEAMPULSE_BACKUP_KEEP=14

# --- LangSmith (optional; free Developer plan) ---
# Key for evaluation experiments: python -m teampulse.eval.langsmith_eval
LANGSMITH_API_KEY=
# "true" also sends live traces of every question. They contain team chat text: demo data or team consent only.
LANGSMITH_TRACING=false
